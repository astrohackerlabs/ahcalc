{
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", "dist", "build", "coverage"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "allowJs": true,
    "outDir": "./dist",
    "declaration": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "extends": "../../../tsconfig.base.json"
}
